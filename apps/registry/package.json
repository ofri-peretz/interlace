{
  "name": "registry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/build-registry.mjs",
    "build": "next build",
    "build:check": "node scripts/build-registry.mjs --check && node scripts/validate-registry.mjs && node scripts/build-changelog.mjs --check",
    "registry:validate": "node scripts/validate-registry.mjs",
    "changelog:build": "node scripts/build-changelog.mjs",
    "changelog:check": "node scripts/build-changelog.mjs --check",
    "registry:e2e": "node scripts/e2e-install.mjs",
    "schema:refresh": "curl -sfL https://ui.shadcn.com/schema/registry-item.json -o schema/registry-item.json && curl -sfL https://ui.shadcn.com/schema/registry.json -o schema/registry.json",
    "dev": "next dev -p 4178",
    "start": "next start -p 4178",
    "lint": "npm run lint:eslint && npm run lint:oxlint",
    "lint:eslint": "eslint .",
    "lint:oxlint": "oxlint -c ../../.oxlintrc.json .",
    "test": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@interlace/ui": "*",
    "next": "^16.2.4",
    "posthog-js": "^1.207.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.8.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "ajv": "^8.20.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
