# PostHog (ANALYTICS_PHILOSOPHY.md)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_DISABLE_REPLAY=

# Where the live component previews are embedded from.
# Defaults to https://storybook.interlace.tools when unset, which is what
# production wants. Point it at a local Storybook when you need to see a
# change to the STORY side — including the theme axis, which only resolves
# against a Storybook that declares the `interlaceTheme` global:
#   cd apps/storybook && npm run storybook          # :6006
#   NEXT_PUBLIC_STORYBOOK_URL=http://localhost:6006 npm run dev
NEXT_PUBLIC_STORYBOOK_URL=
