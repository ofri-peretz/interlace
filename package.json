{
  "name": "interlace",
  "version": "1.0.0",
  "description": "The Interlace community: design system (@interlace/ui), Storybook (storybook.interlace.tools), and the interlace.tools landing page.",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@11.6.2",
  "homepage": "https://interlace.tools",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ofri-peretz/interlace.git"
  },
  "bugs": {
    "url": "https://github.com/ofri-peretz/interlace/issues"
  },
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "prepare": "[ -d .git ] && lefthook install || true",
    "hook:staged": "oxlint -c .oxlintrc.json --no-error-on-unmatched-pattern",
    "hook:verify": "turbo run typecheck test build --output-logs=errors-only",
    "hook:provedone": "provedone gate --mode enforce",
    "hook:test-integrity": "truepass diff --base origin/main",
    "hook:triggerlist": "git cat-file -e origin/main:.sdlc/checklist.yaml 2>/dev/null || { echo 'triggerlist: no checklist on origin/main yet, protect skipped'; exit 0; }; triggerlist protect origin/main",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "lint:guidance": "eslint --config eslint.guidance.config.mjs --no-warn-ignored --suppressions-location .guidance-suppressions.json .",
    "ci:local": "lefthook run pre-push --all-files --force",
    "changeset": "changeset",
    "changeset:check": "node scripts/require-changeset.mjs",
    "version-packages": "changeset version && npm run versions:derive && npm run registry:build && npm install --package-lock-only --ignore-scripts",
    "release": "node scripts/release-tag.mjs && node scripts/release-cli.mjs",
    "versions:derive": "node apps/registry/scripts/derive-component-versions.mjs",
    "versions:check": "node apps/registry/scripts/derive-component-versions.mjs --check",
    "registry:build": "node apps/registry/scripts/build-registry.mjs",
    "sync:philosophies": "tsx scripts/sync-philosophies.ts",
    "sync:philosophies:check": "tsx scripts/sync-philosophies.ts --check"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@eslint/markdown": "^7.5.1",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "eslint": "^9.39.4",
    "eslint-plugin-browser-security": "^3.0.2",
    "eslint-plugin-conventions": "^7.1.0",
    "eslint-plugin-import-next": "^3.0.2",
    "eslint-plugin-maintainability": "^4.0.2",
    "eslint-plugin-modernization": "^4.0.2",
    "eslint-plugin-modularity": "^3.0.2",
    "eslint-plugin-node-security": "^6.0.4",
    "eslint-plugin-operability": "^5.0.2",
    "eslint-plugin-react-a11y": "^3.0.2",
    "eslint-plugin-react-features": "^2.0.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-reliability": "^5.0.2",
    "eslint-plugin-secure-coding": "^6.1.1",
    "lefthook": "^1.7.0",
    "oxlint": "^1.70.0",
    "prettier": "^3.4.0",
    "provedone": "^0.3.1",
    "triggerlist": "^0.3.0",
    "truepass": "^1.0.0",
    "tsx": "^4.19.0",
    "turbo": "^2.9.0",
    "typescript": "^5.7.0"
  }
}
