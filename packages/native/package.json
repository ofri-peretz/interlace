{
  "name": "@interlace/native",
  "version": "0.1.0",
  "private": true,
  "description": "Interlace for React Native: the same tokens and craft as @interlace/ui, rendered as native views.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./theme-model": "./src/theme-model.ts",
    "./contrast": "./src/contrast.ts",
    "./tokens": "./src/tokens.generated.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/build-tokens.mjs --check && vitest run"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": ">=0.81.0",
    "react-native-reanimated": ">=4.0.0",
    "react-native-safe-area-context": ">=5.0.0",
    "react-native-gesture-handler": ">=3.0.0",
    "react-native-worklets": ">=0.5.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "react": "^19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-worklets": "0.13.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@interlace/ui": "*"
  }
}
